# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.pytest_cache/

# ---- Virtual environments ----
venv/
.venv/
env/
ENV/

# ---- IDE / editor ----
.idea/
.vscode/
*.swp
*~

# ---- Microscope data ----
# Raw acquisitions are large and are reproducible only by re-running the
# microscope. They never belong in version control, wherever they end up.
*.czi
# ...except the one small, scrubbed test image the tests read (see tests/fixtures/README.md)
!tests/fixtures/*.czi
*.raw
*.fcs
*.lsm
*.pkl

# ---- Pipeline directories ----
# Per-run output, at the paths of path_config.json. install.bat makes the three folders
# next to DecisionEngine/; docs/examples/points_for_overview.json shows the format of
# the overview points find_overview_positions.czmac writes into temp/.
/image_for_analysis/
/results/
/temp/

# Written by result_processing/results_analyzer.py
founded_points/

# ---- Logs ----
zen_log.txt
*.log

# ---- Model caches ----
.cellpose/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Claude Code ----
.claude/settings.local.json

# ---- Local configuration ----
# The machine paths differ per microscope PC, so each one keeps its own copy, made
# from path_config.example.json next to it (by hand or by install.bat). The presets
# (processing_config.json, selection_config.json) are shared and stay tracked.
ZeissAPI/config/path_config.json
