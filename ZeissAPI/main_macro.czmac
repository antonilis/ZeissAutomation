<Script>
  <Context>Zen26</Context>
  <Version>1.0</Version>
  <Language>Python</Language>
  <Text>
import sys
from System.IO import File

# json, time, uuid, Directory and Path are not used by this macro. They are here because the
# adaptive plugins are run in THIS namespace and have always been able to count on them: fcs_zscan
# builds a PathManager and writes its FCS_points.json with json and Path. Dropping an import here
# silently breaks a plugin at the moment it runs, halfway through an acquisition, so the
# plugin-visible surface is kept whole.
import json
import time
import uuid
from System.IO import Directory, Path

# ZEN keeps its Python engine alive between macro runs, so a module imported once stays in
# sys.modules and an edited file in zen_lib goes unnoticed until ZEN itself is restarted.
# Dropping the package here costs milliseconds and makes what runs always be what is on disk,
# which is also what stops a half finished copy of the folder from looking like it worked.
#
# Every zen_lib import has to come AFTER this loop, PathManager included: a name bound before it
# would keep pointing at the class from the previous run while everything else was re-read.
for _cached in [_name for _name in sys.modules if _name == "zen_lib" or _name.startswith("zen_lib.")]:
    del sys.modules[_cached]

from zen_lib.runtime_config import RuntimeConfig, log
from zen_lib.path_manager_main_macro import PathManager
from zen_lib.zen_api import ZenApi
from zen_lib.zen_gui import list_experiments, show_or_exit, show_problems
from zen_lib.adaptive_loader import load_adaptive_functions
from zen_lib.setup_store import (none_or_value, build_adaptive_experiments, validate_setup,
                                 load_setup, save_setup)
from zen_lib.acquisition_pipeline import AcquisitionPipeline


###################### the two things everything else is handed ########################################
# The configuration lives in the config folder next to this macro, inside the ZEN runtime folder.
# It is located and read exactly once, here, and then handed down to everything that needs a path.
CONFIG = RuntimeConfig()

# ZEN injects about 500 names into THIS namespace - Zen, ZenWindow, ZenSpecialFolder and the rest -
# and an imported module gets none of them. That was measured, not assumed: probe_zen_context.czmac
# found them absent from a module's globals, absent from builtins, and there is no __main__ to
# reach through. So they are collected here and handed down the same way CONFIG is. Nothing in
# zen_lib reaches for a global that only exists inside a macro.
ZEISS_API = ZenApi(Zen, ZenWindow, ZenSpecialFolder, CONFIG)

# The adaptive experiment plugins are read from their files and run in THIS namespace, which is why
# the loader is given globals(): a plugin needs Zen and ZEISS_API, and running it anywhere else
# would put it somewhere those names have never been. The loader also puts @register_adaptive here
# before the plugins run, so a plugin file needs nothing but the decorator.
ADAPTIVE_FUNCTIONS = load_adaptive_functions(CONFIG, globals())


################################## Reading and checking the GUI selections #######################################
# Everything the user can get wrong is caught before the pipeline is built and before anything
# moves. A run started from this macro is unattended, so a bad combination of settings that only
# surfaces halfway through costs an experiment and a plate position. The checks themselves live in
# zen_lib.setup_store; what stays here is the dialogue.

processing_data = CONFIG.processing_config()
selection_data = CONFIG.selection_config()

# Finding the names of the user saved experiments .czexp
experiments = list_experiments(ZEISS_API)

# Without any experiment the dropdowns below would have nothing to offer, and every
# GetValue on them would hand None to Zen.Acquisition.Experiments.GetByName
if not experiments:
    show_problems(ZEISS_API, ["No .czexp experiments were found in the ZEN Experiment Setups folder, "
                              "so there is nothing for this macro to run."])


################################## Code for generating GUI #######################################

# === window 0: reusing the settings of the last run ===
# Offered only when there is something to load. Choosing it skips the windows below entirely:
# the summary is where a loaded setup is confirmed, and it is checked by validate_setup exactly
# like a setup that has just been clicked together.

load_last = False

if File.Exists(CONFIG.last_setup_path):
    window = ZenWindow()
    window.Initialize("Automated Acquisition")
    window.AddCheckbox('load_last_setup', 'Load the settings of the last run:', False)

    result_load = show_or_exit(window)

    load_last = result_load.GetValue('load_last_setup')

if load_last:
    # load_setup raises rather than opening a window of its own, so that everything the user is
    # shown is decided here, in the macro, next to the rest of the dialogue.
    try:
        setup, adaptive_error = load_setup(CONFIG.last_setup_path, ADAPTIVE_FUNCTIONS,
                                           CONFIG.adaptive_path)

    except ValueError as error:
        show_problems(ZEISS_API, [str(error)])

else:
    # === window 1: choosing work modes ===
    window = ZenWindow()
    window.Initialize("Automated Acquisition")
    window.Title = "Automated Acquisition"

    window.AddCheckbox('finding_objects_mode', 'Finding objects mode:', True)
    window.AddCheckbox('multiple_overviews_mode', 'Multiple overviews mode:', True)

    result_mode = show_or_exit(window)

    finding_objects = result_mode.GetValue('finding_objects_mode')
    multiple_overviews = result_mode.GetValue('multiple_overviews_mode')

    # === window 2: choosing experiments and analysis, the analysis arguments are specified in the processing_config===
    window.ClearContent()
    window.Initialize("Automated Acquisition")

    if finding_objects:
        window.AddDropDown('over_exp_name', 'Choose overview experiment:', experiments, 0)
        window.AddDropDown('over_analysis', 'Choose overview analysis:', processing_data.keys(), 0)
        window.AddDropDown('over_selection', 'Choose object selection for the found objects:',
                           ["None"] + selection_data.keys(), 0)
        window.AddDropDown('vis_exp', 'Choose experiment for object visualization:', experiments, 0)
        window.AddDropDown('rean_xy_name', 'Choose reanalysis in xy:', ["None"] + processing_data.keys(), 0)

    window.AddDropDown('z_exp_name', 'Choose experiment for z-reanalysis:', ["None"] + experiments, 0)
    window.AddDropDown('z_analysis', 'Choose z-reanalysis:', ["None"] + processing_data.keys(), 0)
    window.AddCheckbox('is_FCS', 'Is z analysis experiment a FCS experiments:', True)

    window.AddCheckbox('use_adaptive', 'Use adaptive experiments:', False)

    result_setup = show_or_exit(window)

    # === window 3: choosing post-analysis experiments ===
    selected_experiments = []
    done = False

    while not done:
        window = ZenWindow()
        window.Initialize("Select post-analysis experiments")

        # "None" comes first and is the default, so that closing this window with Done and
        # without touching anything leaves the list empty. The object visualization
        # experiment is a measurement in its own right, and often the only one wanted.
        window.AddDropDown('post_exp_name', 'Choose post analysis experiment:', ["None"] + experiments, 0)
        chosen_text = "\n".join(selected_experiments) if selected_experiments else "None yet"
        window.AddMultiLineTextBox('chosen_post_exps', 'Currently selected:', chosen_text)
        window.AddDropDown('action', 'What next?', ['Add another', 'Done', 'Clear all'], 0)

        # Cancelling ends the macro, the same as in the windows above. Continuing with a half
        # filled list would silently run something the user was in the middle of changing.
        result_post = show_or_exit(window)

        action = result_post.GetValue('action')
        new_exp = result_post.GetValue('post_exp_name')

        if action == 'Add another':
            if new_exp != "None" and new_exp not in selected_experiments:
                selected_experiments.append(new_exp)
        elif action == 'Clear all':
            selected_experiments = []
        elif action == 'Done':
            # Done still takes whatever is selected, so that picking an experiment and
            # finishing takes one click instead of two. "None" is the exception.
            if new_exp != "None" and new_exp not in selected_experiments:
                selected_experiments.append(new_exp)
            done = True

    # === window 4: pairing adaptive functions with the experiments they rewrite ===
    # Shown only when asked for, so a run without adaptive experiments costs no extra clicks.
    # The experiments offered are the ones this run will actually execute: pairing a function
    # with an experiment that never runs does nothing and says nothing, and that silence has
    # already cost an afternoon once.

    adaptive_pairs = []
    adaptive_note = ""

    if result_setup.GetValue('use_adaptive'):
        run_experiments = []

        candidates = []

        if finding_objects:
            candidates.append(result_setup.GetValue('vis_exp'))

        candidates.append(none_or_value(result_setup.GetValue('z_exp_name')))
        candidates += selected_experiments

        for candidate in candidates:
            if candidate is not None and candidate not in run_experiments:
                run_experiments.append(candidate)

        if not run_experiments:
            log("Adaptive experiments were asked for, but this run executes no experiments")

        adaptive_done = not run_experiments

        while not adaptive_done:
            window = ZenWindow()
            window.Initialize("Adaptive experiments")

            window.AddDropDown('adaptive_function', 'Adaptive function:',
                               ["None"] + sorted(ADAPTIVE_FUNCTIONS.keys()), 0)
            window.AddDropDown('adaptive_target', 'Applies to experiment:',
                               ["None"] + run_experiments, 0)

            paired_text = "\n".join(["{} -> {}".format(pair[0], pair[1]) for pair in adaptive_pairs])
            window.AddMultiLineTextBox('chosen_pairs', 'Currently paired:',
                                       (paired_text or "None yet") + adaptive_note)

            window.AddDropDown('action', 'What next?', ['Add another', 'Done', 'Clear all'], 0)

            result_adaptive = show_or_exit(window)

            action = result_adaptive.GetValue('action')
            new_function = none_or_value(result_adaptive.GetValue('adaptive_function'))
            new_target = none_or_value(result_adaptive.GetValue('adaptive_target'))

            adaptive_note = ""

            if action == 'Clear all':
                adaptive_pairs = []

            else:
                # Done takes whatever is selected as well, so one pair costs one click. A half
                # filled pair is refused out loud rather than guessed at.
                if new_function is None and new_target is None:
                    pass

                elif new_function is None or new_target is None:
                    adaptive_note = "\n\nA pair needs both a function and an experiment."

                elif new_target in [pair[1] for pair in adaptive_pairs]:
                    adaptive_note = "\n\n{} is already paired. One function per experiment.".format(
                        new_target)

                else:
                    adaptive_pairs.append([new_function, new_target])

                if action == 'Done':
                    adaptive_done = True

    # === collecting the selections into one place and checking them ===
    # Everything below reads this dictionary and nothing calls GetValue again, so the summary
    # window cannot end up describing something other than what the pipeline is given.

    adaptive_experiments, adaptive_error = build_adaptive_experiments(
        adaptive_pairs, ADAPTIVE_FUNCTIONS, CONFIG.adaptive_path)

    setup = {
        'finding_objects': finding_objects,
        'multiple_overviews': multiple_overviews,
        'overview_experiment': result_setup.GetValue('over_exp_name') if finding_objects else None,
        'overview_analysis': result_setup.GetValue('over_analysis') if finding_objects else None,
        'overview_selection': none_or_value(result_setup.GetValue('over_selection')) if finding_objects else None,
        'visualization_experiment': result_setup.GetValue('vis_exp') if finding_objects else None,
        'reanalysis_xy': none_or_value(result_setup.GetValue('rean_xy_name')) if finding_objects else None,
        'z_experiment': none_or_value(result_setup.GetValue('z_exp_name')),
        'z_analysis': none_or_value(result_setup.GetValue('z_analysis')),
        'is_FCS': result_setup.GetValue('is_FCS'),
        'adaptive_experiments': adaptive_experiments,
        'adaptive_pairs': adaptive_pairs,
        'post_experiments': selected_experiments,
    }

# A Z reanalysis needs both halves, so the decision is made once here and everything below
# reads it, instead of spelling the condition out again in each place that runs one.
setup['z_reanalysis'] = setup['z_experiment'] is not None and setup['z_analysis'] is not None

problems = validate_setup(setup, CONFIG, processing_data, selection_data, experiments)

if adaptive_error:
    problems.insert(0, adaptive_error)

if problems:
    show_problems(ZEISS_API, problems)

log("Setup accepted: {}".format(setup))

# === window 5: Summarry for user===
window = ZenWindow()
window.Initialize("Summary of selections")

summary_text = ""

if load_last:
    summary_text += "Loaded from {}\n\n".format(CONFIG.last_setup_path)

summary_text += "Finding objects mode: {}\n".format("Enabled" if setup['finding_objects'] else "Disabled")
summary_text += "Multiple overviews mode: {}\n".format("Enabled" if setup['multiple_overviews'] else "Disabled")

if setup['finding_objects']:
    summary_text += "\nOverview experiment: {}\n".format(setup['overview_experiment'])
    summary_text += "Overview analysis: {}\n".format(setup['overview_analysis'])
    summary_text += "Object selection: {}\n".format(setup['overview_selection'])
    summary_text += "Object visualization experiment: {}\n".format(setup['visualization_experiment'])
    summary_text += "Reanalysis XY: {}\n".format(setup['reanalysis_xy'])

summary_text += "\nZ experiment: {}\n".format(setup['z_experiment'])
summary_text += "Z analysis: {}\n".format(setup['z_analysis'])
summary_text += "Is z experiment a FCS?: {}\n".format(setup['is_FCS'])
if setup['adaptive_pairs']:
    summary_text += "Adaptive experiments:\n"

    for pair in setup['adaptive_pairs']:
        summary_text += "    {} rewriting {}\n".format(pair[0], pair[1])

else:
    summary_text += "Adaptive experiments: none\n"

if setup['post_experiments']:
    summary_text += "\nPost-analysis experiments:\n" + "\n".join(setup['post_experiments'])
else:
    summary_text += "\nNo post-analysis experiments selected."

window.AddMultiLineTextBox('summary_box', 'Summary:', summary_text)

# This is the last point at which the run can still be called off
result_summary = show_or_exit(window)

# What was confirmed becomes the starting point of the next run. Recording it must never cost
# an acquisition, so a failure to write is logged and the run starts anyway.
try:
    save_setup(CONFIG.last_setup_path, setup)
    log("Saved the setup to {}".format(CONFIG.last_setup_path))

except Exception as error:
    log("Could not save the setup to {}: {}".format(CONFIG.last_setup_path, error))


################################## Actual Macro: initializing the AcquisitionPipeline with arguments from the GUI #######################################

# Points that raised on the way. One bad well must not cost the rest of the plate, so the
# failure is logged and the run carries on, and the names are repeated at the end.
failed_points = []

if setup['finding_objects']:

    pipeline = AcquisitionPipeline(CONFIG, ZEISS_API,
                                   object_visualization_experiment=setup['visualization_experiment'],
                                   reanalysis_dict={'xy': setup['reanalysis_xy'],
                                                    'z': {'z_experiment': setup['z_experiment'],
                                                          'z_analysis': setup['z_analysis'],
                                                          'is_FCS': setup['is_FCS']}},
                                   post_reanalysis_experiments=setup['post_experiments'],
                                   adaptive_experiments=setup['adaptive_experiments']
                                   )

    if setup['multiple_overviews']:
        for point in pipeline.points_for_overview:
            try:
                ZEISS_API.move(point['position'])

                pipeline.acquire_overview(overview_experiment=setup['overview_experiment'],
                                          analysis_args=setup['overview_analysis'],
                                          selection_args=setup['overview_selection'], name=point['name'])
                pipeline.capture_objects(name=point['name'])

            except Exception as error:
                failed_points.append(point['name'])
                log("Point {} failed and was skipped: {}".format(point['name'], error))

    else:
        pipeline.acquire_overview(overview_experiment=setup['overview_experiment'],
                                  analysis_args=setup['overview_analysis'],
                                  selection_args=setup['overview_selection'], name=None)
        pipeline.capture_objects(name=None)

else:
    # There is no object in this branch, only the overview points, so the results are not filed
    # under an obj_ folder: A1/A1_experiment_post.czi rather than the obj_uuid folder and uuid in
    # the file name it used to get, which named a directory after an object that was never found.
    pipeline = AcquisitionPipeline(CONFIG, ZEISS_API,
        reanalysis_dict={'z': {'z_experiment': setup['z_experiment'],
                               'z_analysis': setup['z_analysis'],
                               'is_FCS': setup['is_FCS']}},
        adaptive_experiments=setup['adaptive_experiments'],
        per_object_results=False,
    )
    if setup['multiple_overviews']:

        for point in pipeline.points_for_overview:

            try:
                ZEISS_API.move(point['position'])

                # The Z reanalysis is optional here: visiting the overview points and running the
                # post-analysis experiments on each of them is a valid run on its own
                if setup['z_reanalysis']:
                    pipeline._perform_reanalysis_z(obj_id=pipeline.overview_id, name=point['name'])

                for experiment in setup['post_experiments']:
                    pipeline._run_experiment(obj_id=pipeline.overview_id, exp_item=experiment, stage='_post',
                                             name=point['name'], obj=None)

            except Exception as error:
                failed_points.append(point['name'])
                log("Point {} failed and was skipped: {}".format(point['name'], error))

            ZEISS_API.remove_all_documents()

    else:

        if setup['z_reanalysis']:
            pipeline._perform_reanalysis_z(obj_id=pipeline.overview_id)

        for experiment in setup['post_experiments']:
            pipeline._run_experiment(obj_id=pipeline.overview_id, exp_item=experiment, stage='_post')

        ZEISS_API.remove_all_documents()


if failed_points:
    log("Run finished, {} point(s) were skipped after an error: {}".format(
        len(failed_points), ", ".join(failed_points)))
else:
    log("Run finished without skipped points")

