<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Context>Zen26</Context>
  <Version>1.0</Version>
  <Language>Python</Language>
  <Text>
import sys

# ZEN keeps its Python engine alive between macro runs, so a module imported once stays in
# sys.modules and an edited file in zen_lib goes unnoticed until ZEN itself is restarted.
# Dropping the package here costs milliseconds and makes what runs always be what is on disk.
for _cached in [_name for _name in sys.modules if _name == "zen_lib" or _name.startswith("zen_lib.")]:
    del sys.modules[_cached]

from zen_lib.runtime_config import RuntimeConfig, log
from zen_lib.zen_api import ZenApi
from zen_lib.zen_gui import list_experiments, show_or_exit, show_problems
from zen_lib.acquisition_grid import AcquisitionGrid


###################### the two things everything else is handed ########################################
# Same rule as in main_macro: the config folder sits next to this macro in the ZEN runtime folder,
# it is read once here, and the resulting object is passed to AcquisitionGrid instead of letting it
# locate the configuration itself.
CONFIG = RuntimeConfig()

# Zen, ZenWindow and ZenSpecialFolder exist in a macro's namespace and nowhere else - not in an
# imported module's globals, not in builtins, and there is no __main__ to reach through. They are
# collected here and handed down, exactly the way CONFIG is.
ZEISS_API = ZenApi(Zen, ZenWindow, ZenSpecialFolder, CONFIG)


############################ GUI generation ##############################################################################

# Getting the names of the availables .czexp files
experiments = list_experiments(ZEISS_API)

window = ZenWindow()
window.Initialize("Create grid for automated acquisition")
window.Title = "Grig for automated acquisition"
window.AddCheckbox('reading_mode', 'Do you want to read data points from experiments?', False)

result_mode = show_or_exit(window)

window.ClearContent()
window.Initialize("Parameters")

if result_mode.GetValue("reading_mode"):

    window.AddDropDown('exp_name', 'Experiments with tiles:', experiments, 0)

else:

    window.AddIntegerRange('shift_x', 'Shift in x [um]:', 1500, 20, 20000)
    window.AddIntegerRange('shift_y', 'Shift in y [um]:', 1500, 20, 20000)
    # One field instead of a start and an end, because a rectangle was the only thing two fields
    # could express. A plain "A1-C4" still means what it always did.
    window.AddTextBox('wells',
                      'Wells, e.g. "A1-C4" or "A1-H1, A4-H4, E5" (stage on the first one):',
                      'A1-B2')

# The sub-grid applies to the points of both modes, so it is asked for outside the branch above.
# 1x1 is the default and means no sub-grid at all.
window.AddIntegerRange('subgrid_rows', 'Sub-grid rows in every point:', 1, 1, 50)
window.AddIntegerRange('subgrid_cols', 'Sub-grid columns in every point:', 1, 1, 50)
window.AddIntegerRange('subgrid_shift_x', 'Sub-grid shift in x [um]:', 300, 1, 20000)
window.AddIntegerRange('subgrid_shift_y', 'Sub-grid shift in y [um]:', 300, 1, 20000)

# result_parameters, not result_mode: cancelling this window has to end the macro as well,
# otherwise everything below is read out of a dialog that was just abandoned
result_parameters = show_or_exit(window)

############################ Initialization of the code above ##############################################################################

if result_mode.GetValue("reading_mode"):

    chosen_mode = "experiment"
    chosen_manual_points = None
    chosen_experiment = result_parameters.GetValue('exp_name')

else:

    chosen_mode = "manual"
    chosen_manual_points = {"wells": result_parameters.GetValue("wells"),
                            "shift_x": result_parameters.GetValue("shift_x"),
                            "shift_y": result_parameters.GetValue("shift_y"),
                            "start_position": ZEISS_API.get_stage_focus_position()}
    chosen_experiment = None

chosen_subgrid = {"rows": result_parameters.GetValue("subgrid_rows"),
                  "cols": result_parameters.GetValue("subgrid_cols"),
                  "shift_x": result_parameters.GetValue("subgrid_shift_x"),
                  "shift_y": result_parameters.GetValue("subgrid_shift_y")}

# A mistyped well selection is the likeliest thing to go wrong here, and a raw traceback in the
# ZEN macro editor says very little. Nothing has moved at this point, so it is enough to say what
# is wrong and stop.
try:
    grid_manual = AcquisitionGrid(CONFIG, ZEISS_API, mode=chosen_mode,
                                  experiment_name=chosen_experiment,
                                  manual_points=chosen_manual_points, subgrid=chosen_subgrid)

except ValueError as error:
    log("Could not generate the points: {}".format(error))

    show_problems(ZEISS_API, [str(error)], "Cannot generate the points")

# A sub-grid multiplies the number of points, and every one of them is a full overview with
# everything main_macro then does on it. A 96 well plate with a 3x3 sub-grid is 864 overviews,
# so the total is shown before anything is written.
points = grid_manual.points_for_overview

if not points:
    log("No points were generated, nothing was saved")

    raise SystemExit

summary = ZenWindow()
summary.Initialize("Points to save")
summary_text = "{} points in total\n\nFirst: {}\nLast:  {}".format(
    len(points), points[0]['name'], points[-1]['name'])

summary.AddMultiLineTextBox('points_summary',
                            'These points will be written to points_for_overview.json:',
                            summary_text)

result_summary = show_or_exit(summary)

grid_manual.save_overview_points()

