<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Context>Zen26</Context>
  <Version>1.0</Version>
  <Language>Python</Language>
  <Text>
###################### where to put this file before running it ######################################
# This is a diagnostic, kept out of the production macros in ZeissAPI/diagnostics/.
# Standalone: it does not import zen_lib and reads no config. Copy it into any folder ZEN loads
# macros from and run it from the macro editor.
#
###################### what this macro does ############################################################
# Chooses the laser power of an FCS measurement from the sample itself, the way a person would:
#
#   1. probe   SCAN_EXPERIMENT, a short FCS measurement, runs at SENSIBLE_POWER and the count rate is
#              read. With next to no signal the power is raised and the probe repeated
#   2. jump    the count rate is close to linear in the power, so one reading gives the power that
#              should land at TARGET_FRACTION of SAFETY_LIMIT_KHZ, in either direction
#   3. scan    SCAN_FRACTIONS of that power run from the lowest up, reading the count rate and the
#              counts per molecule (CPM). A count rate above SAFETY_LIMIT_KHZ ends the scan and that
#              power stays out of the curve. CPM still rising at the top adds up to EXTEND_STEPS steps,
#              unless a step is expected to pass the limit
#   4. measure the CPM curve is median filtered over 3 neighbouring powers, its top is taken, and
#              MAIN_EXPERIMENT, the normal measurement, runs once at that power
#
# A measurement that passes the limit runs to its end, because no call that stops a running one has
# been tried on the instrument. The first probe may pass it too: it is one short measurement.
#
# The scan and the measurement are two experiments because the measurement time then stays a setting
# of each experiment, and the macro needs no call that has not run on the instrument.
#
# The route to the panel was measured with probe_fcs_live_values.czmac: the windows of ZEN hold
# FcsDetectorCountingViewModel as a DataContext, Execute keeps the UI thread running so a second
# thread can read, and the panel's method can be set from a macro. The panel keeps showing the
# PREVIOUS measurement until its list empties, so a value counts only after the list has been seen
# empty. The first fresh value came about 3.8 s after the start, and each measurement needs a count
# rate and then a CPM, so SCAN_EXPERIMENT should run for about 6 s.
#
# CPM rises with the power and bends over when the dye saturates or bleaches, so the top of the curve
# is already past the linear range.
#
# Before running: open the detector counting panel with its averaging set as wanted.
#
# The stage and the focus are not moved. Powers are changed in memory only and put back at the end,
# also after an error, and so is the method of the panel. The experiments are not saved - if ZEN later
# asks whether to save changes to them, answer No.
#
# Output: smart_fcs_YYYYMMDD_HHMMSS.json on the Desktop, with every sample as the panel showed it,
# plus a window with the curve and the chosen power.

import clr
clr.AddReference("WindowsBase")
clr.AddReference("PresentationCore")
clr.AddReference("PresentationFramework")

import json
import re
import time

from System import Action, Enum, Environment, TimeSpan
from System.IO import Path
from System.Threading import Thread, ThreadStart
from System.Windows import Application
from System.Windows.Media import VisualTreeHelper
from System.Windows.Threading import DispatcherOperationStatus, DispatcherPriority


###################### the two settings ################################################################

SENSIBLE_POWER = 1.0        # % - where a person would start on this sample
SAFETY_LIMIT_KHZ = 50.0     # count rate that must not be passed; also sets where the scan aims

###################### experiments #####################################################################

SCAN_EXPERIMENT = "FCS_scan"                # short FCS measurement, as saved in ZEN
MAIN_EXPERIMENT = "FCS_main"                # the normal FCS measurement, as saved in ZEN
LASER_LINE = "MTBLKM980LaserLine639"        # id of the laser line, as in smart_SLB_imaging

###################### how the search behaves ##########################################################

TARGET_FRACTION = 0.8                       # the jump aims at this fraction of the limit
SCAN_FRACTIONS = [0.125, 0.25, 0.5, 0.7, 1.0]   # of the power from the jump, lowest first
MIN_POWER = 0.01            # %
MAX_POWER = 10.0            # % - never above this, whatever the jump says
MIN_SIGNAL_KHZ = 1.0        # a probe below this is "no signal": the formula would run away
NO_SIGNAL_FACTOR = 4.0      # how much the power is raised after a probe without signal
NO_SIGNAL_RETRIES = 3
EXTEND_FACTOR = 1.4         # step above the scan while CPM keeps rising
EXTEND_STEPS = 2
MIN_POINTS = 3              # fewer powers with a CPM than this and MAIN_EXPERIMENT does not run

SAMPLE_SECONDS = 0.5        # pause between readings of the panel
SETTLE_SECONDS = 2.0        # pause after switching or running an experiment, as in the pipeline
UI_WAIT_SECONDS = 3.0       # how long one reading waits for the UI thread
MAX_SAMPLES = 3600          # a stop, in case a measurement never reports its end

VIEW_MODEL_NAME = "FcsDetectorCountingViewModel"


###################### reporting #######################################################################

REPORT = []


def report(text):
    REPORT.append(text)


###################### laser power #####################################################################


def find_laser_intensity(experiment):
    """
    The Intensity parameter of the laser line, along the same path as ZenApi._laser_intensity, and
    like there looked up again on every use.
    """
    for setup in experiment.Core.CurrentExperimentBlock.SubDimensionSetups:
        if not hasattr(setup, "ActivatedTracks"):
            continue

        for track in setup.ActivatedTracks:
            for collection in track.SelectedDetectionModeSetup.TrackLaserSettings.ParameterCollections:
                if str(collection.Id) == LASER_LINE:
                    return collection["Intensity"]

    raise Exception("{} not found in {}".format(LASER_LINE, experiment.Name))


def activate(name):
    experiment = Zen.Acquisition.Experiments.GetByName(name)

    if experiment is None:
        raise Exception("experiment {} not found".format(name))

    experiment.SetActive()
    time.sleep(SETTLE_SECONDS)
    return experiment


###################### the panel #######################################################################


def find_view_model():
    """
    Walks the windows of ZEN for the view model of the panel. The macro runs on the UI thread, the
    only one allowed to do this.
    """
    for window in Application.Current.Windows:
        stack = [window]

        while stack:
            element = stack.pop()
            context = getattr(element, "DataContext", None)

            if context is not None and context.GetType().Name == VIEW_MODEL_NAME:
                return context

            for index in xrange(VisualTreeHelper.GetChildrenCount(element)):
                stack.append(VisualTreeHelper.GetChild(element, index))

    return None


def find_method(view_model, word):
    """
    The member of the DetectorCountingMethod enum with word in its name, or None.
    """
    for method in Enum.GetValues(view_model.SelectedCountingMethod.GetType()):
        if word in str(method).lower():
            return method

    return None


def parse_value(text):
    """
    The number at the start of what the panel shows, such as '3.671 kHz', or None.
    """
    match = re.search(r"-?[0-9]+([.,][0-9]+)?", text)

    return float(match.group(0).replace(",", ".")) if match else None


###################### reading during a measurement ####################################################

STATE = {"view_model": None, "count_rate_method": None, "cpm_method": None, "stop": False, "fresh": False,
         "skip": False, "started": 0.0, "samples": [], "count_rate": None, "cpm": None}


def tick():
    """
    One reading of the panel, on the UI thread. A value counts only after the list has been empty
    once in this measurement; before that it belongs to the previous one. The first fresh count rate
    switches the panel to CPM, and the reading right after a switch is skipped, because it may still
    show the old method.
    """
    try:
        view_model = STATE["view_model"]
        method = str(view_model.SelectedCountingMethod)
        values = [str(entry.Value) for entry in view_model.CountRateValues]

        STATE["samples"].append({"t_s": round(time.time() - STATE["started"], 1), "method": method,
                                 "values": values})

        if len(values) == 0:
            STATE["fresh"] = True
            return

        if STATE["skip"]:
            STATE["skip"] = False
            return

        number = parse_value(values[0])

        if not STATE["fresh"] or number is None:
            return

        if method == str(STATE["count_rate_method"]):
            STATE["count_rate"] = number
            view_model.SelectedCountingMethod = STATE["cpm_method"]
            STATE["skip"] = True
        else:
            STATE["cpm"] = number

    except Exception as error:
        STATE["samples"].append({"error": str(error)})


def reading_loop():
    dispatcher = Application.Current.Dispatcher

    for index in xrange(MAX_SAMPLES):
        if STATE["stop"]:
            return

        operation = dispatcher.BeginInvoke(DispatcherPriority.Normal, Action(tick))

        if operation.Wait(TimeSpan.FromSeconds(UI_WAIT_SECONDS)) != DispatcherOperationStatus.Completed:
            operation.Abort()
            STATE["samples"].append({"error": "UI thread busy"})

        time.sleep(SAMPLE_SECONDS)


def measure(experiment):
    """
    Runs the experiment once and reads the panel while it runs.
    :return: tuple (first fresh count rate or None, last fresh CPM or None, list of all samples)
    """
    STATE.update({"stop": False, "fresh": False, "skip": False, "started": time.time(), "samples": [],
                  "count_rate": None, "cpm": None})
    STATE["view_model"].SelectedCountingMethod = STATE["count_rate_method"]

    thread = Thread(ThreadStart(reading_loop))
    thread.IsBackground = True
    thread.Start()

    try:
        Zen.Acquisition.Execute(experiment)
    finally:
        STATE["stop"] = True
        thread.Join(TimeSpan.FromSeconds(UI_WAIT_SECONDS + SAMPLE_SECONDS + 1))

    return STATE["count_rate"], STATE["cpm"], STATE["samples"]


MEASUREMENTS = []


def run_once(experiment, power, phase):
    """
    One short measurement at one power, recorded in MEASUREMENTS.
    :return: the entry, with count_rate_khz and cpm_khz, which are None without a fresh value
    """
    entry = {"phase": phase, "power_percent": power, "count_rate_khz": None, "cpm_khz": None}
    MEASUREMENTS.append(entry)

    find_laser_intensity(experiment).Value = str(power)

    try:
        entry["count_rate_khz"], entry["cpm_khz"], entry["samples"] = measure(experiment)
    except Exception as error:
        entry["error"] = str(error)
        report("{} {} %: FAILED - {}".format(phase, power, error))
        return entry

    report("{} {} %: count rate {} kHz, CPM {} kHz".format(
        phase, power, entry["count_rate_khz"], entry["cpm_khz"]))

    time.sleep(SETTLE_SECONDS)
    return entry


###################### choosing the powers #############################################################


def clamp_power(power):
    return round(min(max(power, MIN_POWER), MAX_POWER), 4)


def over_limit(count_rate):
    return count_rate is not None and count_rate &gt; SAFETY_LIMIT_KHZ


def top_power(power, count_rate):
    """
    The power that should land at TARGET_FRACTION of the limit, from one reading.
    """
    return clamp_power(power * SAFETY_LIMIT_KHZ * TARGET_FRACTION / count_rate)


def scan_powers(top):
    """
    SCAN_FRACTIONS of the top power, lowest first, without the duplicates clamping can make.
    """
    return sorted(set(clamp_power(top * fraction) for fraction in SCAN_FRACTIONS))


def still_rising(points):
    """
    True when the last CPM is the highest so far: the curve has not bent yet.
    """
    return points[-1][1] == max(cpm for power, cpm in points)


def smooth(values):
    """
    Median of every value and its neighbours, so that one noisy short measurement cannot win alone,
    which a mean does not prevent. At the two ends, with one neighbour, the lower of the two.
    """
    result = []

    for index in range(len(values)):
        window = sorted(values[max(index - 1, 0):index + 2])
        result.append(window[(len(window) - 1) // 2])

    return result


def choose_power(points):
    """
    :param list points: (power, CPM) of the powers that gave a value, lowest power first
    :return: the lowest power at the top of the smoothed curve
    """
    smoothed = smooth([cpm for power, cpm in points])
    top = smoothed.index(max(smoothed))

    return points[top][0]


###################### the search ######################################################################


def probe(experiment):
    """
    Finds a power with a usable signal, starting from SENSIBLE_POWER.
    :return: tuple (power, count rate), or None when there is no signal or no reading at all
    """
    power = clamp_power(SENSIBLE_POWER)

    for attempt in range(NO_SIGNAL_RETRIES + 1):
        count_rate = run_once(experiment, power, "probe")["count_rate_khz"]

        if count_rate is None:
            report("no fresh value from the panel - is {} long enough?".format(SCAN_EXPERIMENT))
            return None

        if count_rate &gt;= MIN_SIGNAL_KHZ:
            return power, count_rate

        if power == MAX_POWER:
            break

        power = clamp_power(power * NO_SIGNAL_FACTOR)

    report("no signal up to {} % - empty spot or out of focus?".format(power))
    return None


def scan_cpm(experiment, top):
    """
    Runs the powers up to top, and further while CPM keeps rising, until the limit is passed.
    :return: list of (power, CPM), lowest power first
    """
    queue = scan_powers(top)
    points = []
    extended = 0

    while queue:
        power = queue.pop(0)
        entry = run_once(experiment, power, "scan")

        if over_limit(entry["count_rate_khz"]):
            entry["over_limit"] = True
            report("count rate above {} kHz - scan stopped, {} % stays out of the curve".format(
                SAFETY_LIMIT_KHZ, power))
            return points

        if entry["cpm_khz"] is not None:
            points.append((power, entry["cpm_khz"]))

        if len(queue) == 0 and extended != EXTEND_STEPS and points and still_rising(points):
            following = clamp_power(power * EXTEND_FACTOR)
            expected_rate = (entry["count_rate_khz"] or 0.0) * following / power

            # A step that is expected to pass the limit is not taken at all
            if following != power and not over_limit(expected_rate):
                queue.append(following)
                extended += 1

    return points


###################### run ############################################################################

scan_experiment = activate(SCAN_EXPERIMENT)
original_scan_power = find_laser_intensity(scan_experiment).Value

view_model = find_view_model()
if view_model is None:
    raise Exception("the detector counting panel was not found - open it and run the macro again")

STATE["view_model"] = view_model
STATE["count_rate_method"] = find_method(view_model, "countrate")
STATE["cpm_method"] = find_method(view_model, "molecule")

if STATE["count_rate_method"] is None or STATE["cpm_method"] is None:
    raise Exception("the panel has no count rate or no counts per molecule method")

original_method = view_model.SelectedCountingMethod

report("start at {} %, limit {} kHz, scan {}, main {}".format(
    SENSIBLE_POWER, SAFETY_LIMIT_KHZ, SCAN_EXPERIMENT, MAIN_EXPERIMENT))

top = None
points = []
chosen = None
main_result = None

try:
    found = probe(scan_experiment)

    if found is not None:
        top = top_power(found[0], found[1])
        report("jump: {} kHz at {} % -&gt; scan up to {} %".format(found[1], found[0], top))
        points = scan_cpm(scan_experiment, top)

finally:
    view_model.SelectedCountingMethod = original_method

    try:
        find_laser_intensity(scan_experiment).Value = original_scan_power
    except Exception as error:
        report("RESTORE FAILED - {} - set {} back to {} % by hand".format(error, SCAN_EXPERIMENT, original_scan_power))

if len(points) &gt;= MIN_POINTS:
    chosen = choose_power(points)
    report("chosen power {} %".format(chosen))

    if still_rising(points):
        report("WARNING: CPM was still rising at {} % - the curve did not bend".format(points[-1][0]))

    main = activate(MAIN_EXPERIMENT)
    original_main_power = find_laser_intensity(main).Value

    try:
        find_laser_intensity(main).Value = str(chosen)
        Zen.Acquisition.Execute(main)
        time.sleep(SETTLE_SECONDS)
        main_result = "finished"
        report("{} finished at {} %".format(MAIN_EXPERIMENT, chosen))
    except Exception as error:
        main_result = str(error)
        report("{} FAILED - {}".format(MAIN_EXPERIMENT, error))
    finally:
        try:
            find_laser_intensity(main).Value = original_main_power
        except Exception as error:
            report("RESTORE FAILED - {} - set {} back to {} % by hand".format(error, MAIN_EXPERIMENT, original_main_power))

else:
    report("only {} powers gave a CPM - {} was NOT run".format(len(points), MAIN_EXPERIMENT))

record = {
    "sensible_power_percent": SENSIBLE_POWER,
    "safety_limit_khz": SAFETY_LIMIT_KHZ,
    "scan_experiment": SCAN_EXPERIMENT,
    "main_experiment": MAIN_EXPERIMENT,
    "laser_line": LASER_LINE,
    "top_power_percent": top,
    "chosen_power_percent": chosen,
    "main_result": main_result,
    "focus_z": Zen.Devices.Focus.ActualPosition,
    "time": time.strftime("%Y-%m-%d %H:%M:%S"),
    "measurements": MEASUREMENTS,
}

json_path = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.Desktop),
                         "smart_fcs_{}.json".format(time.strftime("%Y%m%d_%H%M%S")))
with open(json_path, "w") as json_file:
    json.dump(record, json_file, indent=2)
report("written {}".format(json_path))

output = ZenWindow()
output.Initialize("smart_fcs")
output.AddMultiLineTextBox("report", "Full data in {}".format(json_path), "\n".join(REPORT))
output.Show()
