<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Context>Zen26</Context>
  <Version>1.0</Version>
  <Language>Python</Language>
  <Text>
###################### where to put this file before running it ######################################
# This is a diagnostic, kept out of the production macros in ZeissAPI/diagnostics/.
# It imports zen_lib, so it only works from the folder main_macro.czmac runs from (ZeissAPI/ in the
# repo, with zen_lib/ next to it). Copy it there for the run, and delete it there afterwards.
#
###################### what this probe answers #########################################################
# The first step towards a smart FCS: how many kcounts/s does the detector see at laser power A, B, C?
#
# For every power in POWERS the laser is set in memory and FCS_EXPERIMENT is executed, the same way
# the pipeline does it. An FCS experiment gives no image: ZEN writes .fcs and .raw files to its
# autosave folder (zeiss_temp_file in path_config.json). Every .raw holds the photons of one
# detector, so
#
#   kcounts/s = photons / duration / 1000
#
# The layout of the .raw is the one IO/read_raw_corr_file.py reads: a 128 byte header, the sync rate
# as the 4th uint32 of the settings, then one uint32 per photon, the time since the previous photon
# in sync units. Check duration_s in the JSON against the measurement time of the experiment: if
# they agree, the sync rate is understood correctly.
#
# Keep the measurement short in the experiment - a few seconds are enough for a mean count rate, and
# every power runs it once. The files stay in the autosave folder; this probe only reads them.
#
# The stage and the focus are not moved. The laser power is changed in memory only and put back at
# the end, also after an error. The experiment is not saved - if ZEN later asks whether to save
# changes to it, answer No.
#
# Output: smart_fcs_probe_YYYYMMDD_HHMMSS.json in results_path of path_config.json, plus a window
# with the same report, also written to the log.

import sys
import json
import struct
import time

for _cached in [_name for _name in sys.modules if _name == "zen_lib" or _name.startswith("zen_lib.")]:
    del sys.modules[_cached]

from System import DateTime
from System.IO import File, Path

from zen_lib.runtime_config import RuntimeConfig, log
from zen_lib.path_manager_main_macro import PathManager


###################### settings ########################################################################

FCS_EXPERIMENT = "FCS_experiment"            # the FCS experiment, as saved in ZEN
LASER_LINE = "MTBLKM980LaserLine639"         # id of the laser line, as in smart_SLB_imaging

POWER_A = 0.1     # %
POWER_B = 0.2     # %
POWER_C = 0.4     # %
POWERS = [POWER_A, POWER_B, POWER_C]

SETTLE_SECONDS = 2.0    # pause after the experiment, the same rest the pipeline gives it

RAW_HEADER_BYTES = 128
RAW_SYNC_RATE_OFFSET = 92     # 64 text + 16 identifier + 3 * 4 into the settings
RAW_CHUNK_BYTES = 4 * 1024 * 1024


###################### reporting #######################################################################

REPORT = []


def report(text):
    REPORT.append(text)
    log(text)


###################### laser power #####################################################################


def find_laser_intensity(experiment):
    """
    The Intensity parameter of the laser line, along the same path as ZenApi._laser_intensity:
    Core.CurrentExperimentBlock.SubDimensionSetups[*].ActivatedTracks[*]
        .SelectedDetectionModeSetup.TrackLaserSettings.ParameterCollections[Id == LASER_LINE]
    """
    block = experiment.Core.CurrentExperimentBlock

    for setup in block.SubDimensionSetups:
        if not hasattr(setup, "ActivatedTracks"):
            continue

        for track in setup.ActivatedTracks:
            for collection in track.SelectedDetectionModeSetup.TrackLaserSettings.ParameterCollections:
                if str(collection.Id) == LASER_LINE:
                    return collection["Intensity"]

    return None


###################### count rate ######################################################################


def raw_count_rate(path):
    """
    Photons, duration and count rate of one .raw file, read in chunks so that a long measurement
    does not have to fit in memory as Python integers.
    """
    with open(path, "rb") as raw_file:
        header = raw_file.read(RAW_HEADER_BYTES)
        sync_rate = struct.unpack("&lt;I", header[RAW_SYNC_RATE_OFFSET:RAW_SYNC_RATE_OFFSET + 4])[0]

        photons = 0
        ticks = 0
        while True:
            chunk = raw_file.read(RAW_CHUNK_BYTES)
            count = len(chunk) // 4
            if count == 0:
                break
            photons += count
            ticks += sum(struct.unpack("&lt;{}I".format(count), chunk[:count * 4]))

    duration = float(ticks) / sync_rate if sync_rate else None

    return {
        "file": path.replace("\\", "/").split("/")[-1],
        "photons": photons,
        "sync_rate": sync_rate,
        "duration_s": duration,
        "kcounts_per_s": photons / duration / 1000.0 if duration else None,
    }


def new_raw_files(path_manager, started):
    """
    The .raw files of the measurement that just ended. The autosave folder keeps older measurements,
    so a newest .fcs from before the start means this run wrote nothing.
    """
    files = path_manager.get_latest_fcs_and_raws()

    if len(files) == 0 or File.GetLastWriteTime(files[0]) &lt; started:
        raise Exception("no new .fcs in {} - is autosave on in the experiment?".format(
            path_manager.zeiss_temp))

    return [path for path in files if path.lower().endswith(".raw")]


###################### run ############################################################################

CONFIG = RuntimeConfig()
PATHS = PathManager(CONFIG)

report("--- smart_fcs probe ---")
report("experiment {}, laser {}, powers {} %".format(FCS_EXPERIMENT, LASER_LINE, POWERS))

experiment = Zen.Acquisition.Experiments.GetByName(FCS_EXPERIMENT)
if experiment is None:
    report("RESULT: experiment {} not found - stopping".format(FCS_EXPERIMENT))
    raise Exception("experiment not found")

experiment.SetActive()

intensity = find_laser_intensity(experiment)
if intensity is None:
    report("RESULT: {} not found in {} - stopping".format(LASER_LINE, FCS_EXPERIMENT))
    raise Exception("laser line not found")

original = intensity.Value
report("original power {} %".format(original))

measurements = []
try:
    for power in POWERS:
        entry = {"power_set_percent": power}
        measurements.append(entry)

        intensity.Value = str(power)
        entry["power_read_back_percent"] = float(str(intensity.Value))

        started = DateTime.Now
        started_clock = time.time()
        try:
            Zen.Acquisition.Execute(experiment)
            time.sleep(SETTLE_SECONDS)
            entry["experiment_s"] = round(time.time() - started_clock, 1)
            entry["detectors"] = [raw_count_rate(path) for path in new_raw_files(PATHS, started)]
        except Exception as error:
            entry["error"] = str(error)
            report("{} %: FAILED - {}".format(power, error))
            continue

        for detector in entry["detectors"]:
            report("{} %: {} kcounts/s | {} photons in {} s | {}".format(
                power, detector["kcounts_per_s"], detector["photons"], detector["duration_s"],
                detector["file"]))

finally:
    try:
        intensity.Value = original
        report("restored power to {} %".format(intensity.Value))
    except Exception as error:
        report("RESTORE FAILED - {} - set the laser back to {} % by hand".format(error, original))

record = {
    "experiment": FCS_EXPERIMENT,
    "laser_line": LASER_LINE,
    "original_power_percent": float(str(original)),
    "focus_z": Zen.Devices.Focus.ActualPosition,
    "time": time.strftime("%Y-%m-%d %H:%M:%S"),
    "measurements": measurements,
}

json_path = Path.Combine(CONFIG.results, "smart_fcs_probe_{}.json".format(time.strftime("%Y%m%d_%H%M%S")))
with open(json_path, "w") as json_file:
    json.dump(record, json_file, indent=2)
report("written {}".format(json_path))

output = ZenWindow()
output.Initialize("smart_fcs probe")
output.AddMultiLineTextBox("report", "Also written to the log:", "\n".join(REPORT))
output.Show()
</Text>
  <Author></Author>
  <Description></Description>
  <Keywords></Keywords>
  <Row>1</Row>
  <Column>1</Column>
</Script>
