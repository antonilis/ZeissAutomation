<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Context>Zen26</Context>
  <Version>1.0</Version>
  <Language>Python</Language>
  <Text>
###################### where to put this file before running it ######################################
# This is a diagnostic, kept out of the production macros in ZeissAPI/diagnostics/.
# Standalone: it does not import zen_lib and reads no config. Copy it into any folder ZEN loads
# macros from and run it from the macro editor.
#
###################### what this probe answers #########################################################
# How do the count rate and the number of molecules change with the laser power?
#
# For every power in POWERS the laser of the ACTIVE experiment is set in memory, the experiment runs
# with its own measurement time, and the values are read live from ZEN's detector counting panel:
#
#   molecules = count rate / counts per molecule
#
# The route to the panel was measured with probe_fcs_live_values.czmac: the windows of ZEN hold
# FcsDetectorCountingViewModel as a DataContext, its CountRateValues update during a measurement, and
# Execute keeps the UI thread running, so a second thread can read while the macro waits.
#
# Three things that follow from that measurement:
#   - the panel keeps showing the PREVIOUS measurement until the list empties, about 2 s after the
#     start. A value counts only after the list has been seen empty
#   - the first fresh value came about 3.8 s after the start, so a measurement needs several seconds
#     more than that, for both the count rate and the counts per molecule to arrive
#   - the panel shows one method at a time, so the macro switches it after every value it reads.
#     If it cannot be switched, only the count rate is written
#
# Before running: select the FCS experiment and open the panel with the detector counts.
#
# The stage and the focus are not moved. The power is changed in memory only and put back at the
# end, also after an error, and so is the method of the panel. The experiment is not saved - if ZEN
# later asks whether to save changes to it, answer No. ZEN saves its .fcs and .raw files as usual.
#
# Output: smart_fcs_YYYYMMDD_HHMMSS.json on the Desktop, with every sample as the panel showed it,
# plus a window with the summary.

import clr
clr.AddReference("WindowsBase")
clr.AddReference("PresentationCore")
clr.AddReference("PresentationFramework")

import json
import re
import time

from System import Action, Enum, Environment, TimeSpan
from System.IO import Path
from System.Threading import Thread, ThreadStart
from System.Windows import Application
from System.Windows.Media import VisualTreeHelper
from System.Windows.Threading import DispatcherOperationStatus, DispatcherPriority


###################### settings ########################################################################

LASER_LINE = "MTBLKM980LaserLine639"    # id of the laser line, as in smart_SLB_imaging

POWER_A = 0.1     # %
POWER_B = 0.2     # %
POWER_C = 0.4     # %
POWERS = [POWER_A, POWER_B, POWER_C]

SAMPLE_SECONDS = 1.0        # pause between readings of the panel
SETTLE_SECONDS = 2.0        # pause after the experiment, the same rest the pipeline gives it
UI_WAIT_SECONDS = 3.0       # how long one reading waits for the UI thread
MAX_SAMPLES = 3600          # a stop, in case a measurement never reports its end

VIEW_MODEL_NAME = "FcsDetectorCountingViewModel"


###################### reporting #######################################################################

REPORT = []


def report(text):
    REPORT.append(text)


###################### laser power #####################################################################


def find_laser_intensity(experiment):
    """
    The Intensity parameter of the laser line, along the same path as ZenApi._laser_intensity.
    """
    for setup in experiment.Core.CurrentExperimentBlock.SubDimensionSetups:
        if not hasattr(setup, "ActivatedTracks"):
            continue

        for track in setup.ActivatedTracks:
            for collection in track.SelectedDetectionModeSetup.TrackLaserSettings.ParameterCollections:
                if str(collection.Id) == LASER_LINE:
                    return collection["Intensity"]

    return None


###################### the panel #######################################################################


def find_view_model():
    """
    Walks the windows of ZEN for the view model of the panel. The macro runs on the UI thread, the
    only one allowed to do this.
    """
    for window in Application.Current.Windows:
        stack = [window]

        while stack:
            element = stack.pop()
            context = getattr(element, "DataContext", None)

            if context is not None and context.GetType().Name == VIEW_MODEL_NAME:
                return context

            for index in xrange(VisualTreeHelper.GetChildrenCount(element)):
                stack.append(VisualTreeHelper.GetChild(element, index))

    return None


def find_method(view_model, word):
    """
    The member of the DetectorCountingMethod enum with word in its name, or None.
    """
    for method in Enum.GetValues(view_model.SelectedCountingMethod.GetType()):
        if word in str(method).lower():
            return method

    return None


def methods_to_read(view_model):
    """
    The methods to cycle through: count rate and counts per molecule, or only the count rate when
    the panel cannot be switched from a macro. The switch is tried here, before any measurement.
    """
    count_rate = find_method(view_model, "countrate")
    per_molecule = find_method(view_model, "molecule")

    if per_molecule is None:
        report("no counts per molecule among the methods - writing the count rate only")
        return [count_rate]

    try:
        view_model.SelectedCountingMethod = per_molecule
        view_model.SelectedCountingMethod = count_rate
    except Exception as error:
        report("the panel cannot be switched ({}) - writing the count rate only".format(error))
        return [count_rate]

    return [count_rate, per_molecule]


def parse_value(text):
    """
    The number at the start of what the panel shows, such as '37.568 kHz', or None.
    """
    match = re.search(r"-?[0-9]+([.,][0-9]+)?", text)

    return float(match.group(0).replace(",", ".")) if match else None


###################### reading during a measurement ####################################################

STATE = {"view_model": None, "methods": [], "stop": False, "fresh": False, "next": 0, "started": 0.0,
         "samples": [], "last": {}}


def tick():
    """
    One reading of the panel, on the UI thread. Takes a value only after the list has been empty once
    in this measurement, then moves on to the next method.
    """
    try:
        view_model = STATE["view_model"]
        method = str(view_model.SelectedCountingMethod)
        values = [str(entry.Value) for entry in view_model.CountRateValues]

        STATE["samples"].append({"t_s": round(time.time() - STATE["started"], 1), "method": method,
                                 "values": values})

        if len(values) == 0:
            STATE["fresh"] = True
            return

        number = parse_value(values[0])

        if not STATE["fresh"] or number is None:
            return

        STATE["last"][method] = number
        STATE["next"] = (STATE["next"] + 1) % len(STATE["methods"])
        view_model.SelectedCountingMethod = STATE["methods"][STATE["next"]]

    except Exception as error:
        STATE["samples"].append({"error": str(error)})


def reading_loop():
    dispatcher = Application.Current.Dispatcher

    for index in xrange(MAX_SAMPLES):
        if STATE["stop"]:
            return

        operation = dispatcher.BeginInvoke(DispatcherPriority.Normal, Action(tick))

        if operation.Wait(TimeSpan.FromSeconds(UI_WAIT_SECONDS)) != DispatcherOperationStatus.Completed:
            operation.Abort()
            STATE["samples"].append({"error": "UI thread busy"})

        time.sleep(SAMPLE_SECONDS)


def measure(experiment):
    """
    Runs the experiment once and reads the panel while it runs.
    :return: tuple (dict of method name to its last fresh value, list of all samples)
    """
    STATE.update({"stop": False, "fresh": False, "next": 0, "started": time.time(), "samples": [], "last": {}})
    STATE["view_model"].SelectedCountingMethod = STATE["methods"][0]

    thread = Thread(ThreadStart(reading_loop))
    thread.IsBackground = True
    thread.Start()

    try:
        Zen.Acquisition.Execute(experiment)
    finally:
        STATE["stop"] = True
        thread.Join(TimeSpan.FromSeconds(UI_WAIT_SECONDS + SAMPLE_SECONDS + 1))

    return STATE["last"], STATE["samples"]


###################### run ############################################################################

experiment = Zen.Acquisition.Experiments.ActiveExperiment
report("experiment {}, laser {}, powers {} %".format(experiment.Name, LASER_LINE, POWERS))

intensity = find_laser_intensity(experiment)
if intensity is None:
    raise Exception("{} not found in {}".format(LASER_LINE, experiment.Name))

view_model = find_view_model()
if view_model is None:
    raise Exception("the detector counting panel was not found - open it and run the macro again")

original_power = intensity.Value
original_method = view_model.SelectedCountingMethod

STATE["view_model"] = view_model
STATE["methods"] = methods_to_read(view_model)

count_rate_name = str(STATE["methods"][0])
per_molecule_name = str(STATE["methods"][-1]) if len(STATE["methods"]) == 2 else None

measurements = []
try:
    for power in POWERS:
        entry = {"power_set_percent": power}
        measurements.append(entry)

        intensity.Value = str(power)
        entry["power_read_back_percent"] = float(str(intensity.Value))

        try:
            last, samples = measure(experiment)
        except Exception as error:
            entry["error"] = str(error)
            report("{} %: FAILED - {}".format(power, error))
            continue

        rate = last.get(count_rate_name)
        per_molecule = last.get(per_molecule_name)

        entry["count_rate_khz"] = rate
        entry["counts_per_molecule_khz"] = per_molecule
        entry["molecules"] = rate / per_molecule if rate and per_molecule else None
        entry["samples"] = samples

        report("{} %: count rate {} kHz, CPM {} kHz, molecules {}".format(
            power, rate, per_molecule, entry["molecules"]))

        time.sleep(SETTLE_SECONDS)

finally:
    try:
        intensity.Value = original_power
        report("restored power to {} %".format(intensity.Value))
    except Exception as error:
        report("RESTORE FAILED - {} - set the laser back to {} % by hand".format(error, original_power))

    view_model.SelectedCountingMethod = original_method

record = {
    "experiment": experiment.Name,
    "laser_line": LASER_LINE,
    "original_power_percent": float(str(original_power)),
    "focus_z": Zen.Devices.Focus.ActualPosition,
    "time": time.strftime("%Y-%m-%d %H:%M:%S"),
    "measurements": measurements,
}

json_path = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.Desktop),
                         "smart_fcs_{}.json".format(time.strftime("%Y%m%d_%H%M%S")))
with open(json_path, "w") as json_file:
    json.dump(record, json_file, indent=2)
report("written {}".format(json_path))

output = ZenWindow()
output.Initialize("smart_fcs")
output.AddMultiLineTextBox("report", "Full data in {}".format(json_path), "\n".join(REPORT))
output.Show()
</Text>
  <Author></Author>
  <Description></Description>
  <Keywords></Keywords>
  <Row>1</Row>
  <Column>1</Column>
